rules_version = '2';

// Regras do Firestore da Somara.
//
// Colar no separador "Rules" da consola do Firebase e publicar. Sem isto,
// uma base criada em "modo de teste" fica aberta a qualquer pessoa da
// internet durante 30 dias — e depois fecha-se sozinha e a app pára.
//
// A regra é uma só: cada aluno lê e escreve o seu próprio documento, mais
// nada. Ninguém pode ler o progresso de outra criança, nem listar quem
// existe. São dados de menores; o mínimo é este.
service cloud.firestore {
  match /databases/{database}/documents {

    match /learners/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // As regras não descem sozinhas: a linha de cima cobre o documento do
    // aluno e mais nada do que estiver por baixo dele. Hoje a app só
    // escreve nesse documento, em campos — nunca em subcolecções. Isto
    // está aqui para o dia em que passar a guardar, por exemplo, o
    // histórico de cada lição: nesse dia funciona, e continua fechado ao
    // dono. Sem esta linha pareceria bug na app, e era regra a faltar.
    match /learners/{uid}/{subcoleccao=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Isto documenta a intenção; não é isto que fecha a porta. O Firestore
    // recusa por omissão tudo o que nenhuma regra permita, e as regras só
    // sabem permitir: um "if false" nunca concede nada, e também nunca
    // revoga o que outra regra concedeu.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
